# z-coc-go 环境变量示例
#
# 用法：复制本文件为 .env，并填入真实值。
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会入库；请勿把真实密钥提交到仓库。
#
# 标注说明：【必填】= 缺失将导致服务无法启动或部署失败；【可选】= 有默认值，可按需覆盖。

# ---------------------------------------------------------------------------
# 数据库配置
# ---------------------------------------------------------------------------

# 【必填】数据库主机
#   方案一（应用连“已有”PostgreSQL 容器）：填写已有数据库的容器名（需接入同一 Docker 网络）。
#   方案二（docker-compose.full.yml）：由 compose 固定为 db，本项在 .env 中忽略即可。
PGSQL_HOST=your-db-host

# 【必填】数据库用户
PGSQL_USERNAME=your-db-user

# 【必填】数据库密码
PGSQL_PASSWORD=your-db-password

# 【必填】数据库名
PGSQL_DATABASE=z-coc

# 【可选】数据库端口，默认 5432
PGSQL_PORT=5432

# ---------------------------------------------------------------------------
# 应用 / 网络
# ---------------------------------------------------------------------------

# 【可选】应用容器对外映射端口，默认 8080
APP_PORT=8080

# 【可选】方案一使用的外部 Docker 网络名，默认 zcoc-net
DOCKER_NETWORK=zcoc-net

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# 【可选】跨域来源白名单：
#   - 同域（前端与 API 同源）留空；
#   - 跨域 / 原生端用逗号分隔的“完整 Origin”，禁止使用 *；
#   - Capacitor 原生端需包含 https://localhost,capacitor://localhost
# 示例：
# APP_ALLOWED_ORIGINS=https://example.com,https://localhost,capacitor://localhost
APP_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# 管理员引导
# ---------------------------------------------------------------------------
# 【可选】逗号分隔的管理员邮箱列表。服务启动时、以及这些邮箱登录时，
# 会把对应账号提升为管理员（users.role='admin'）。留空表示不自动提升。
# 之后可在 /Admin/ 后台由管理员继续授予/撤销他人管理员。
# 例：ADMIN_EMAILS=you@example.com,another@example.com
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# 测试开关（生产请勿设置）
# ---------------------------------------------------------------------------
# 【测试用】设为 1/true 时关闭固定窗口限流；仅供本地/冒烟测试（repeated runs）。
# 生产环境务必留空，否则会失去防滥用限流。
RATE_LIMIT_DISABLED=

# ---------------------------------------------------------------------------
# 反向代理（真实客户端 IP）
# ---------------------------------------------------------------------------
# 【可选】当本服务位于可信反向代理（openresty/nginx）之后、且反代已透传
# X-Forwarded-For 或 X-Real-IP 时，设为 1，让限流与日志使用真实客户端 IP。
# 直连或无反代时留空。注意：仅当反代可信时才开启，否则该头可被伪造以绕过限流。
TRUST_PROXY_HEADERS=

# ---------------------------------------------------------------------------
# 兼容别名（可选，优先级低于 PGSQL_*）
# ---------------------------------------------------------------------------
# DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME
# DATABASE_URL=postgres://user:pass@host:5432/db
