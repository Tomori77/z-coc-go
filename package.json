{
  "name": "z-coc",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.css --minify",
    "build:mobile-web": "pnpm build:css && node tools/build-mobile.mjs",
    "mobile:sync": "pnpm build:mobile-web && cap sync android",
    "mobile:open": "cap open android",
    "mobile:build:debug": "pnpm mobile:sync && cd android && gradlew.bat assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "daisyui": "4.7.2",
    "dompurify": "3.0.6",
    "file-saver": "2.0.5",
    "html-docx-js": "0.3.1",
    "localforage": "1.10.0",
    "mammoth": "1.6.0",
    "marked": "12.0.2",
    "vue": "3.5.13"
  }
}
